# 必填：OpenAI 或兼容 OpenAI API 的访问密钥
OPENAI_API_KEY=

# 可选：使用自定义网关时填写；官方 OpenAI API 可留空
OPENAI_BASE_URL=

# 可选：模型与短 system prompt；留空时使用代码默认值
MODEL=gpt-5.6-terra
SYSTEM_PROMPT=你是一个有用的助手，可以调用工具来帮助用户。

# 可选：仅 web_search 和 fetch_url 工具需要
TAVILY_API_KEY=

# 可选：当前代码尚未输出 agent 日志，默认留空即可
LOG_LEVEL=

# 必填：Session PostgreSQL 数据库；测试使用独立的 TEST_DATABASE_URL
DATABASE_URL=postgresql://user:password@localhost:5432/demo_agent
TEST_DATABASE_URL=postgresql://user:password@localhost:5432/demo_agent_test

# 可选：Session 数据库连接池
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=5
DB_POOL_TIMEOUT_SECONDS=5
