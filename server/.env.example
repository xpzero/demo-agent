# 必填：智谱开放平台 API 密钥（https://open.bigmodel.cn）
API_KEY=

# 可选：默认使用智谱 OpenAI 兼容接口；如需换成其他兼容网关再填写
BASE_URL=

# 可选：模型与短 system prompt；留空时使用代码默认值
MODEL=glm-4.6
SYSTEM_PROMPT=你是一个有用的助手，可以调用工具来帮助用户。

# 可选：未摘要原文超过此字符数后触发滚动摘要；默认 12000，需填正整数
SUMMARY_ROLL_TRIGGER=12000

# 可选：local 暴露全部教学工具；public 使用公开演示白名单，隐藏 calculate 和 write_file
TOOL_PROFILE=local

# 可选：仅 web_search 和 fetch_url 工具需要
TAVILY_API_KEY=

# 可选：当前代码尚未输出 agent 日志，默认留空即可
LOG_LEVEL=
